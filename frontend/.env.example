# Backend API URL (production: set to deployed backend URL)
VITE_API_URL=http://localhost:5001

# Pexels API Key for image search
VITE_PEXELS_API_KEY=your_pexels_api_key_here

# Geoapify API Key for geocoding
VITE_GEOAPIFY_API_KEY=your_geoapify_api_key_here

# Firebase Configuration (optional: set if using environment variables)
# VITE_FIREBASE_API_KEY=your_firebase_api_key
# VITE_FIREBASE_AUTHDOMAIN=your_firebase_auth_domain
# VITE_FIREBASE_PROJECTID=your_firebase_project_id
# VITE_FIREBASE_STORAGEBUCKET=your_firebase_storage_bucket
# VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
# VITE_FIREBASE_APPID=your_firebase_app_id
# VITE_FIREBASE_MEASUREMENT_ID=your_firebase_measurement_id
